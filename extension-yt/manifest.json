{
  "manifest_version": 3,
  "name": "Descargar videos de YouTube",
  "version": "1.6",
  "permissions": ["activeTab", "downloads", "nativeMessaging"],
  "host_permissions": ["http://localhost:8000/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-32.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-32.png",
    "128": "icons/icon-128.png"
  }
}